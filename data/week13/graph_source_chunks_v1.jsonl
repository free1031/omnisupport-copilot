{"chunk_id":"w13-chunk-workspace-sso","evidence_id":"w13-ev-workspace-sso","doc_id":"w13-doc-workspace-incident","source_id":"w13-src-workspace-incident","content":"Northstar Workspace 4.2 customers may enter an SSO login loop after an identity-provider certificate rotation. The observable symptom is repeated redirect to the sign-in page. The verified recovery is to refresh the SSO metadata and rotate the stale session token.","data_release_id":"data-week13-v1","product_line":"northstar_workspace","visibility_scope":"internal","annotations":{"entities":[{"type":"PRODUCT","name":"Northstar Workspace"},{"type":"ISSUE","name":"SSO login loop"},{"type":"SYMPTOM","name":"Repeated sign-in redirect"},{"type":"RESOLUTION","name":"Refresh SSO metadata and rotate stale session token"},{"type":"VERSION","name":"4.2"}],"relations":[{"type":"HAS_ISSUE","source_type":"PRODUCT","source":"Northstar Workspace","target_type":"ISSUE","target":"SSO login loop"},{"type":"HAS_SYMPTOM","source_type":"ISSUE","source":"SSO login loop","target_type":"SYMPTOM","target":"Repeated sign-in redirect"},{"type":"RESOLVED_BY","source_type":"ISSUE","source":"SSO login loop","target_type":"RESOLUTION","target":"Refresh SSO metadata and rotate stale session token"},{"type":"APPLIES_TO_VERSION","source_type":"RESOLUTION","source":"Refresh SSO metadata and rotate stale session token","target_type":"VERSION","target":"4.2"}]}}
{"chunk_id":"w13-chunk-workspace-cache","evidence_id":"w13-ev-workspace-cache","doc_id":"w13-doc-workspace-runbook","source_id":"w13-src-workspace-runbook","content":"Workspace users may see stale permissions after a role update because the authorization cache was not invalidated. Invalidate the authorization cache and ask the user to start a new session.","data_release_id":"data-week13-v1","product_line":"northstar_workspace","visibility_scope":"internal","annotations":{"entities":[{"type":"PRODUCT","name":"Workspace"},{"type":"ISSUE","name":"Stale authorization cache"},{"type":"SYMPTOM","name":"Updated role is not visible"},{"type":"RESOLUTION","name":"Invalidate authorization cache and start a new session"}],"relations":[{"type":"HAS_ISSUE","source_type":"PRODUCT","source":"Workspace","target_type":"ISSUE","target":"Stale authorization cache"},{"type":"HAS_SYMPTOM","source_type":"ISSUE","source":"Stale authorization cache","target_type":"SYMPTOM","target":"Updated role is not visible"},{"type":"RESOLVED_BY","source_type":"ISSUE","source":"Stale authorization cache","target_type":"RESOLUTION","target":"Invalidate authorization cache and start a new session"}]}}
{"chunk_id":"w13-chunk-edge-cert","evidence_id":"w13-ev-edge-cert","doc_id":"w13-doc-edge-incident","source_id":"w13-src-edge-incident","content":"Northstar Edge Gateway 3.9 can reject upstream TLS connections after the intermediate certificate expires. The symptom is a certificate verify failed message. Install the renewed intermediate certificate and reload the gateway trust store.","data_release_id":"data-week13-v1","product_line":"northstar_edge_gateway","visibility_scope":"internal","annotations":{"entities":[{"type":"PRODUCT","name":"Northstar Edge Gateway"},{"type":"ISSUE","name":"Expired intermediate certificate"},{"type":"SYMPTOM","name":"Certificate verify failed"},{"type":"RESOLUTION","name":"Install renewed intermediate certificate and reload trust store"},{"type":"VERSION","name":"3.9"}],"relations":[{"type":"HAS_ISSUE","source_type":"PRODUCT","source":"Northstar Edge Gateway","target_type":"ISSUE","target":"Expired intermediate certificate"},{"type":"HAS_SYMPTOM","source_type":"ISSUE","source":"Expired intermediate certificate","target_type":"SYMPTOM","target":"Certificate verify failed"},{"type":"RESOLVED_BY","source_type":"ISSUE","source":"Expired intermediate certificate","target_type":"RESOLUTION","target":"Install renewed intermediate certificate and reload trust store"},{"type":"APPLIES_TO_VERSION","source_type":"RESOLUTION","source":"Install renewed intermediate certificate and reload trust store","target_type":"VERSION","target":"3.9"}]}}
{"chunk_id":"w13-chunk-edge-clock","evidence_id":"w13-ev-edge-clock","doc_id":"w13-doc-edge-runbook","source_id":"w13-src-edge-runbook","content":"Edge Gateway authentication can fail when node clocks drift beyond five minutes. The failure appears as token not yet valid. Restore NTP synchronization before rotating credentials.","data_release_id":"data-week13-v1","product_line":"northstar_edge_gateway","visibility_scope":"internal","annotations":{"entities":[{"type":"PRODUCT","name":"Edge Gateway"},{"type":"ISSUE","name":"Node clock drift"},{"type":"SYMPTOM","name":"Token not yet valid"},{"type":"RESOLUTION","name":"Restore NTP synchronization"}],"relations":[{"type":"HAS_ISSUE","source_type":"PRODUCT","source":"Edge Gateway","target_type":"ISSUE","target":"Node clock drift"},{"type":"HAS_SYMPTOM","source_type":"ISSUE","source":"Node clock drift","target_type":"SYMPTOM","target":"Token not yet valid"},{"type":"RESOLVED_BY","source_type":"ISSUE","source":"Node clock drift","target_type":"RESOLUTION","target":"Restore NTP synchronization"}]}}
