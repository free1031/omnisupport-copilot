{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnisupport.local/contracts/release/release_manifest_v2.schema.json",
  "title": "Week14 Governed Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec", "integrity"],
  "properties": {
    "api_version": {"const": "omnisupport.ai/v2"},
    "kind": {"const": "GovernedRelease"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "environment", "created_at", "created_by", "approved_by", "git_sha", "previous_release_id", "previous_manifest_digest"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^omni-(dev|staging|prod)-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{3}$"},
        "environment": {"enum": ["dev", "staging", "prod"]},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "approved_by": {"type": ["string", "null"]},
        "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "previous_release_id": {"type": ["string", "null"]},
        "previous_manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "quality", "business_slo", "rollout", "governance"],
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "index", "prompt", "model", "skills", "graph"],
          "properties": {
            "data": {"$ref": "#/$defs/dataComponent"},
            "index": {"$ref": "#/$defs/indexComponent"},
            "prompt": {"$ref": "#/$defs/promptComponent"},
            "model": {"$ref": "#/$defs/modelComponent"},
            "skills": {"$ref": "#/$defs/skillsComponent"},
            "graph": {"$ref": "#/$defs/graphComponent"}
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eval"],
          "properties": {
            "eval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "gate_status", "report_path", "artifact_digests"],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "gate_status": {"enum": ["pass", "fail"]},
                "report_path": {"type": "string", "minLength": 1},
                "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
              }
            }
          }
        },
        "business_slo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id", "status", "artifact_digests"],
          "properties": {
            "policy_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["pass", "fail"]},
            "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
          }
        },
        "rollout": {"$ref": "#/$defs/rolloutPolicy"},
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_ticket", "data_classification", "required_approvals"],
          "properties": {
            "change_ticket": {"type": "string", "minLength": 1},
            "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
            "required_approvals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_digest", "signature"],
      "properties": {
        "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": {"enum": ["none", "hmac-sha256", "external"]},
            "key_id": {"type": ["string", "null"]},
            "value": {"type": ["string", "null"]}
          }
        }
      }
    }
  },
  "$defs": {
    "artifactDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "dataComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "lakefs_repository", "lakefs_ref", "iceberg_snapshot_ids", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "lakefs_repository": {"type": "string", "minLength": 1},
        "lakefs_ref": {"type": "string", "minLength": 1},
        "iceberg_snapshot_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "indexComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "data_release_id", "embedding_model", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "data_release_id": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "promptComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "template_versions", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "template_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "modelComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "provider", "model_id", "snapshot", "system_card", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "snapshot": {"type": "string", "minLength": 1},
        "system_card": {"type": "string", "minLength": 1},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "skillsComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "packs", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "packs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "graphComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "schema_version", "artifact_digests"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "artifact_digests": {"$ref": "#/$defs/artifactDigests"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "operator", "threshold"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"enum": [">", ">=", "<", "<=", "=="]},
        "threshold": {"type": "number"}
      }
    },
    "rolloutPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["stages", "red_lines"],
      "properties": {
        "stages": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["traffic_percent", "min_samples", "min_observation_minutes", "gates", "baseline_guards"],
            "properties": {
              "traffic_percent": {"enum": [5, 25, 50, 100]},
              "min_samples": {"type": "integer", "minimum": 1},
              "min_observation_minutes": {"type": "number", "exclusiveMinimum": 0},
              "gates": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
              "baseline_guards": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
            }
          }
        },
        "red_lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
      }
    }
  }
}
